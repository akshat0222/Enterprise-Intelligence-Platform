# Copy to .env (git-ignored). Never commit real secrets.
ENVIRONMENT=development
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=20

# Used from the LLM/embedding phase onward
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# local = free MiniLM model (default), openai = needs OPENAI_API_KEY with credit, hash = tests only
EMBEDDING_PROVIDER=local
# Relevance gate: minimum cosine similarity (tuned for the local MiniLM model; retune if you change embedder)
MIN_SIMILARITY=0.4
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Must match the region the keys were created in: https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US)
LANGFUSE_HOST=https://cloud.langfuse.com
